{
  "name": "r2m-v5",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.11 <23",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @r2m/database generate",
    "db:migrate": "pnpm --filter @r2m/database migrate",
    "db:seed": "pnpm --filter @r2m/database seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "eslint": "^9.18.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  }
}
