# --- App ---
NODE_ENV=development
API_PORT=3000

# --- Database (PostgreSQL 16+) ---
DATABASE_URL=postgres://r2m:r2m@localhost:5432/r2m_dev

# --- Cache / Queue ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible, private buckets only) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=r2m
S3_SECRET_ACCESS_KEY=r2m-secret
S3_VERIFICATION_BUCKET=r2m-verification-private
S3_RESOURCE_BUCKET=r2m-resource-private
S3_SIGNED_URL_TTL_SECONDS=300

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL_SECONDS=2592000
