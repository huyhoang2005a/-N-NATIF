{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "API_PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_VERIFICATION_BUCKET",
        "S3_RESOURCE_BUCKET",
        "S3_SIGNED_URL_TTL_SECONDS",
        "JWT_ACCESS_SECRET",
        "JWT_ACCESS_TTL_SECONDS",
        "JWT_REFRESH_SECRET",
        "JWT_REFRESH_TTL_SECONDS"
      ]
    }
  }
}
